<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <!--
        Required on Android 11+ (API 30) so the app can see an installed
        text-to-speech engine. Without this the spoken verdict stays silent.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_tomato"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TomatoRipeness">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InfoActivity"
            android:exported="false"
            android:label="@string/info_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.TomatoRipeness.Info" />
    </application>

</manifest>
